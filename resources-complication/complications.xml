<!--
   A single static complication so that Connect IQ watch faces can launch the
   application via Complications.exitTo() (press and hold). It carries no value
   and is never updated, i.e. no extra API calls or background work.
   The id must remain 0 in all future versions as watch faces may persist it.
-->
<resources>
    <complications>
        <complication id="0" access="public"
                      longLabel="@Strings.AppName"
                      icon="@Drawables.ComplicationIcon">
            <faceIt defaultText="@Strings.AppName" />
        </complication>
    </complications>
</resources>
